{
  "name": "session-scribe",
  "version": "0.1.0",
  "description": "Record meetings and lectures with OBS, transcribe them with configurable AI providers, and produce grounded summaries.",
  "author": {
    "name": "JanMrt-d",
    "email": "janmertes@outlook.com"
  },
  "homepage": "https://github.com/JanMrt-d/SessionScribe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanMrt-d/SessionScribe.git"
  },
  "bugs": {
    "url": "https://github.com/JanMrt-d/SessionScribe/issues"
  },
  "keywords": [
    "electron",
    "obs",
    "transcription",
    "whisper",
    "diarization",
    "meeting-notes",
    "local-first"
  ],
  "desktopName": "SessionScribe",
  "main": "./out/main/index.js",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run test/integration",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:packaged:linux": "SESSION_SCRIBE_E2E_EXECUTABLE=release/linux-unpacked/sessionscribe playwright test",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "checksums": "node scripts/write-checksums.mjs",
    "package": "npm run build && npm run prepare:ffmpeg && electron-builder --publish never && npm run checksums",
    "package:linux": "npm run build && npm run prepare:ffmpeg && electron-builder --linux AppImage rpm --x64 --publish never && npm run checksums",
    "package:win": "npm run build && npm run prepare:ffmpeg && electron-builder --win nsis --x64 --publish never && npm run checksums"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "obs-websocket-js": "5.0.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.1.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "jsdom": "30.0.1",
    "lucide-react": "1.24.0",
    "prettier": "3.9.5",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.10",
    "ws": "8.21.0"
  },
  "build": {
    "appId": "com.sessionscribe.desktop",
    "productName": "SessionScribe",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/diarization",
        "to": "diarization"
      }
    ],
    "artifactName": "SessionScribe-${version}-${arch}.${ext}",
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "rpm"
      ],
      "category": "AudioVideo;Utility",
      "executableName": "sessionscribe",
      "syncDesktopName": true,
      "maintainer": "JanMrt-d <janmertes@outlook.com>"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
